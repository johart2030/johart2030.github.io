{
  "rules": {
    ".read": false,
    ".write": false,
    "activeSessions": {
      ".read": true,
      "$uid": {
        "$sessionId": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || (newData.hasChildren(['state', 'signedIn', 'displayName', 'lastChanged']) && newData.child('state').val() === 'online' && newData.child('signedIn').isBoolean() && newData.child('displayName').isString() && newData.child('lastChanged').isNumber())",
          "state": {
            ".validate": "newData.val() === 'online'"
          },
          "signedIn": {
            ".validate": "newData.isBoolean()"
          },
          "displayName": {
            ".validate": "newData.isString()"
          },
          "lastChanged": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.hasChildren(['state', 'lastChanged']) && (newData.child('state').val() === 'online' || newData.child('state').val() === 'offline') && newData.child('lastChanged').isNumber())",
        "state": {
          ".validate": "newData.val() === 'online' || newData.val() === 'offline'"
        },
        "displayName": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "lastChanged": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "openRooms": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous'",
      "$roomId": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous'",
        ".validate": "!newData.exists() || (newData.hasChildren(['type', 'rounds', 'createdAt']) && (newData.child('type').val() === 'reaction' || newData.child('type').val() === 'math' || newData.child('type').val() === 'typing') && newData.child('rounds').isNumber() && newData.child('createdAt').isNumber())",
        "type": {
          ".validate": "newData.val() === 'reaction' || newData.val() === 'math' || newData.val() === 'typing'"
        },
        "rounds": {
          ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === 3 || newData.val() === 5 || newData.val() === 7 || newData.val() === 10)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (!data.exists() || data.child('status').val() === 'waiting' || data.child('players').child(auth.uid).exists())",
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (!data.exists() || data.child('status').val() === 'waiting' || data.child('players').child(auth.uid).exists())",
        ".validate": "!newData.exists() || (newData.hasChildren(['id', 'type', 'rounds', 'currentRound', 'status', 'host', 'createdAt', 'players']) && newData.child('id').val() === $roomId && newData.child('host').isString() && newData.child('createdAt').isNumber())",
        "id": {
          ".validate": "newData.isString() && newData.val() === $roomId"
        },
        "type": {
          ".validate": "newData.val() === 'reaction' || newData.val() === 'math' || newData.val() === 'typing'"
        },
        "rounds": {
          ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === 3 || newData.val() === 5 || newData.val() === 7 || newData.val() === 10)"
        },
        "currentRound": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= newData.parent().child('rounds').val()"
        },
        "status": {
          ".validate": "newData.val() === 'waiting' || newData.val() === 'countdown' || newData.val() === 'playing' || newData.val() === 'betweenRounds' || newData.val() === 'complete'"
        },
        "host": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "public": {
          ".validate": "!newData.exists() || newData.isBoolean()"
        },
        "players": {
          "$uid": {
            ".validate": "!newData.exists() || (newData.hasChildren(['name', 'ready', 'finished', 'score', 'wins', 'connected', 'joinedAt', 'lastSeen']) && newData.child('name').isString() && newData.child('ready').isBoolean() && newData.child('finished').isBoolean() && newData.child('score').isNumber() && newData.child('wins').isNumber() && newData.child('connected').isBoolean() && newData.child('joinedAt').isNumber() && newData.child('lastSeen').isNumber())",
            "name": {
              ".validate": "newData.isString()"
            },
            "ready": {
              ".validate": "newData.isBoolean()"
            },
            "finished": {
              ".validate": "newData.isBoolean()"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "wins": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
            },
            "connected": {
              ".validate": "newData.isBoolean()"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "lastSeen": {
              ".validate": "newData.isNumber()"
            },
            "finishedAt": {
              ".validate": "!newData.exists() || newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "seed": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)"
        },
        "startAt": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "completedAt": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "socialPresence": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous'",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.hasChildren(['state','lastSeen']) && newData.child('state').isString() && newData.child('lastSeen').isNumber())"
      }
    }
  }
}