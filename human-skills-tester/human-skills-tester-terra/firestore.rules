rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function permanent() { return request.auth != null && request.auth.token.firebase.sign_in_provider != "anonymous"; }
    function owner(uid) { return permanent() && request.auth.uid == uid; }
    function participant(data) { return permanent() && request.auth.uid in data.members; }
    match /users/{uid} {
      allow read, create, update, delete: if owner(uid);
      match /scores/{test} { allow read, create, update, delete: if owner(uid); }
    }
    match /usernames/{key} {
      allow read: if true;
      allow create: if permanent() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if permanent() && resource.data.uid == request.auth.uid;
    }
    match /publicProfiles/{uid} { allow read: if true; allow create, update, delete: if owner(uid); }
    match /leaderboards/{test}/entries/{uid} { allow read: if true; allow create, update, delete: if owner(uid); }
    match /friendships/{id} {
      allow get: if participant(resource.data);
      allow list: if permanent() && request.auth.uid in resource.data.members;
      allow create: if permanent() && request.resource.data.status == "pending" && request.resource.data.requestedBy == request.auth.uid && request.resource.data.members.size() == 2 && request.auth.uid in request.resource.data.members;
      allow update: if participant(resource.data) && request.resource.data.members == resource.data.members;
      allow delete: if participant(resource.data);
    }
    match /{document=**} { allow read, write: if false; }
  }
}