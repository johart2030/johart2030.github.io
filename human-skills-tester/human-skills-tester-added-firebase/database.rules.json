{"rules":{".read":false,".write":false,"presence":{"$uid":{".read":"auth != null",".write":"auth != null && auth.uid === $uid",".validate":"newData.hasChildren(['state','lastChanged']) && newData.child('state').isString()"}},"openRooms":{".read":"auth != null","$room":{".write":"auth != null"}},"rooms":{"$room":{".read":"auth != null && data.child('players').child(auth.uid).exists() || auth != null && data.child('status').val() === 'waiting'",".write":"auth != null",".validate":"newData.hasChildren(['id','type','status','host','players']) && (newData.child('type').val() === 'reaction' || newData.child('type').val() === 'math' || newData.child('type').val() === 'typing')","players":{"$uid":{".write":"auth != null && (auth.uid === $uid || data.parent().parent().child('host').val() === auth.uid)"}}}}}}