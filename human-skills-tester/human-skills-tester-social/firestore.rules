rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
 function signedIn(){return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';}
 match /users/{uid} {
  allow read: if signedIn();
  allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.displayName is string && request.resource.data.displayName.size() >= 3 && request.resource.data.displayName.size() <= 20;
  allow delete: if signedIn() && request.auth.uid == uid;
  match /scores/{score} { allow read: if signedIn() && request.auth.uid == uid; allow write: if signedIn() && request.auth.uid == uid && request.resource.data.value is number; }
 }
 match /usernames/{name} { allow read: if true; allow create: if signedIn() && !exists(/databases/$(database)/documents/usernames/$(name)) && request.resource.data.uid == request.auth.uid; allow update: if false; allow delete: if signedIn() && resource.data.uid == request.auth.uid; }
 match /leaderboards/{test}/entries/{uid} {
  allow read: if true;
  allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.displayName is string && request.resource.data.displayName.size() >= 3 && request.resource.data.displayName.size() <= 20 && request.resource.data.value is number && request.resource.data.value >= 0;
  allow delete: if signedIn() && request.auth.uid == uid;
 }
 match /{document=**} { allow read, write: if false; }
}}